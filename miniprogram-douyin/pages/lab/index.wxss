.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 32rpx 0 24rpx;
}
.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.header-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 提示词测试入口卡片（抖音红渐变） */
.prompt-tester-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FE2C55 0%, #E02048 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(254, 44, 85, 0.25);
}
.prompt-tester-entry:active { opacity: 0.9; }
.prompt-tester-entry .entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.25) !important;
}
.prompt-tester-entry .entry-icon-text { font-size: 40rpx; }
.prompt-tester-entry .entry-info { flex: 1; min-width: 0; }
.prompt-tester-entry .entry-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}
.prompt-tester-entry .entry-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.prompt-tester-entry .entry-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skill-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  gap: 24rpx;
}
.skill-card:active {
  opacity: 0.7;
}

.skill-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.skill-icon-text {
  font-size: 40rpx;
}

.skill-info {
  flex: 1;
  min-width: 0;
}
.skill-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}
.skill-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
}
.footer-text {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.8;
}
