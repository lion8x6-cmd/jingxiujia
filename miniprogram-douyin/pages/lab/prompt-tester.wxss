.page {
  padding: 24rpx 24rpx 160rpx;
  background: #f7f7f7;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.history-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #FE2C55;
  padding: 10rpx 20rpx;
  background: #f0faf4;
  border-radius: 30rpx;
}

.history-icon {
  font-size: 28rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.required {
  color: #e24b4a;
}

/* ===== 图片选择 ===== */
.image-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  border: 2rpx dashed #d0d0d0;
  border-radius: 12rpx;
  background: #fafafa;
}

.picker-icon {
  font-size: 72rpx;
  color: #c0c0c0;
  line-height: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
}

.picker-hint {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.image-preview {
  width: 100%;
}

.preview-img {
  width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.image-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.img-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #FE2C55;
  background: #f0faf4;
  border-radius: 8rpx;
}

.img-btn.danger {
  color: #e24b4a;
  background: #fef0f0;
}

/* ===== 分类栏 ===== */
.manage-btn {
  font-size: 26rpx;
  color: #FE2C55;
  padding: 8rpx 20rpx;
}

.category-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #666;
  background: #f3f3f3;
  border-radius: 30rpx;
}

.cat-chip.active {
  color: #fff;
  background: #FE2C55;
}

/* ===== 提示词列表 ===== */
.prompt-list {
  max-height: 480rpx;
}

.prompt-card {
  padding: 20rpx;
  background: #fafafa;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}

.prompt-card.active {
  background: #f0faf4;
  border-color: #FE2C55;
}

.prompt-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.prompt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.prompt-card-actions {
  display: flex;
  gap: 16rpx;
}

.prompt-edit {
  font-size: 24rpx;
  color: #FE2C55;
}

.prompt-del {
  font-size: 24rpx;
  color: #e24b4a;
}

.prompt-badge {
  font-size: 22rpx;
  color: #999;
}

.prompt-preview {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-hint {
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  padding: 40rpx 0;
}

.add-prompt-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #FE2C55;
  border: 2rpx dashed #FE2C55;
  border-radius: 10rpx;
}

/* ===== 提示词输入 ===== */
.prompt-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
  background: #fafafa;
  border-radius: 10rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.prompt-textarea.negative {
  min-height: 120rpx;
  margin-top: 0;
}

.placeholder {
  color: #bbb;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.negative-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.toggle-arrow {
  font-size: 24rpx;
  color: #999;
}

/* ===== 生成按钮 ===== */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-generate {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #FE2C55;
  border-radius: 44rpx;
  border: none;
  line-height: 1;
}

.btn-generate-text {
  display: block;
  line-height: 1;
}

.btn-generate.disabled {
  background: #c0c0c0;
  color: #fff;
}

.btn-generate::after {
  border: none;
}

/* ===== 结果 ===== */
.result-section {
  padding-bottom: 40rpx;
}

.result-img-wrap {
  position: relative;
  width: 100%;
  margin-top: 16rpx;
}

.result-img {
  width: 100%;
  border-radius: 12rpx;
  display: block;
}

.zoom-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  z-index: 2;
}

.zoom-icon {
  font-size: 32rpx;
  color: #fff;
  line-height: 1;
}

.badge {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #fff;
  border-radius: 20rpx;
  z-index: 2;
}

.badge.original {
  background: rgba(226, 75, 74, 0.85);
}

.badge.result {
  background: rgba(254, 44, 85, 0.85);
}

.compare-hint {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.result-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #FE2C55;
  background: #f0faf4;
  border-radius: 10rpx;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 85vh;
  overflow-y: auto;
}

.modal.show {
  transform: translateY(0);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f7f7f7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.modal-btn.cancel {
  background: #f3f3f3;
  color: #666;
}

.modal-btn.confirm {
  background: #FE2C55;
  color: #fff;
}

.modal-btn.confirm.disabled {
  background: #c0c0c0;
}

.toast-hint {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx 40rpx;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 28rpx;
  border-radius: 10rpx;
  z-index: 300;
}
