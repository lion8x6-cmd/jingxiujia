page {
  height: 100%;
  background: #0D0E14;
}

.page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  background: linear-gradient(180deg, #1A1024 0%, #0D0E14 45%, #1A0D18 100%);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* ===== 背景装饰 ===== */
.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}
.bg-glow-pink {
  width: 520rpx;
  height: 520rpx;
  background: #FE2C55;
  top: -160rpx;
  right: -140rpx;
}
.bg-glow-cyan {
  width: 420rpx;
  height: 420rpx;
  background: #25F4EE;
  bottom: 200rpx;
  left: -180rpx;
  opacity: 0.25;
}
.bg-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1rpx, transparent 1rpx);
  background-size: 60rpx 60rpx;
  pointer-events: none;
  z-index: 0;
}

/* ===== 顶部品牌 ===== */
.brand {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding-top: calc(40rpx + env(safe-area-inset-top));
}
.brand-logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: block;
  box-shadow: 0 8rpx 24rpx rgba(254, 44, 85, 0.35);
  flex-shrink: 0;
}
.brand-text {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
.brand-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

/* ===== 主视觉 ===== */
.hero {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 16rpx;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  background: rgba(254, 44, 85, 0.14);
  border: 1rpx solid rgba(254, 44, 85, 0.35);
  margin-bottom: 18rpx;
}
.hero-tag text {
  font-size: 21rpx;
  color: #FF8AA3;
  line-height: 1;
}
.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FE2C55;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx #FE2C55;
}

.hero-title {
  font-size: 74rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.08;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
}
.hero-title-accent {
  background: linear-gradient(90deg, #FE2C55 0%, #FF8A65 50%, #25F4EE 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.hero-desc {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.62);
  max-width: 580rpx;
}

/* ===== 底部 CTA ===== */
.bottom-panel {
  position: relative;
  z-index: 2;
  width: 100%;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-top: 16rpx;
}
.start-btn {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: 104rpx;
  padding: 14rpx 0;
  min-width: 0 !important;
  max-width: none !important;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #FE2C55 0%, #FF5577 100%);
  box-shadow: 0 12rpx 32rpx rgba(254, 44, 85, 0.45),
              0 2rpx 8rpx rgba(254, 44, 85, 0.25);
  border: none;
  margin: 0;
  box-sizing: border-box;
  line-height: 1;
  transition: transform 0.12s ease;
}
.start-btn::after { border: none; }
.start-btn-hover {
  transform: scale(0.97);
  box-shadow: 0 6rpx 16rpx rgba(254, 44, 85, 0.35);
}
.start-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}
.start-btn-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  line-height: 1;
}
.start-btn-arrow {
  font-size: 40rpx;
  font-weight: 400;
  color: #FFFFFF;
  margin-left: 16rpx;
  line-height: 1;
}
.start-btn-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  line-height: 1;
}

/* 个性化修图入口 */
.custom-entry {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 42rpx;
  border: 2rpx solid rgba(254, 44, 85, 0.65);
  background: rgba(254, 44, 85, 0.12);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: transform 0.12s ease;
}
.custom-entry-hover {
  transform: scale(0.97);
  background: rgba(254, 44, 85, 0.22);
}
.custom-entry-icon {
  font-size: 34rpx;
  color: #FF8AA3;
  margin-right: 12rpx;
  line-height: 1;
}
.custom-entry-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF8AA3;
  letter-spacing: 2rpx;
  line-height: 1;
}
.custom-entry-sub {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1;
}

/* ===== 更多工具宫格（深色玻璃卡片）===== */
.tools-head {
  display: flex;
  align-items: baseline;
  margin-top: 22rpx;
  margin-bottom: 12rpx;
}
.tools-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
}
.tools-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.38);
}
.tools-grid {
  display: flex;
  flex-wrap: wrap;
}
.tool-item {
  width: 48%;
  box-sizing: border-box;
  height: 92rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  padding: 0 18rpx;
  margin-right: 4%;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
}
.tool-item:nth-child(even) { margin-right: 0; }
.tool-item.hl {
  border-color: rgba(254, 44, 85, 0.55);
  background: rgba(254, 44, 85, 0.1);
}
.tool-item-hover { background: rgba(255, 255, 255, 0.1); }
.tool-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.tool-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.tool-icon-blue   { background: #E6F1FB; }
.tool-icon-purple { background: #EEEDFE; }
.tool-icon-green  { background: #E1F5EE; }
.tool-icon-amber  { background: #FAEEDA; }
.tool-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.tool-name {
  font-size: 25rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tool-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.25;
  margin-top: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}
.tip-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}
.tip-dot {
  margin: 0 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* 赚钱悬浮按钮（分销素材入口） */
.money-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FF8A3D 0%, #FF6B1A 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 26, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
  transition: transform 0.12s ease;
}
.money-fab-hover { transform: scale(0.92); }
.money-fab-yen {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}
.money-fab-txt {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  margin-top: 4rpx;
}
