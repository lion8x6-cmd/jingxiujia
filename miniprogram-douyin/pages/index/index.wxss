page {
  height: 100%;
  background: #0D0E14;
}

.page {
  position: relative;
  width: 100%;
  min-height: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #1A1024 0%, #0D0E14 45%, #1A0D18 100%);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* ===== 背景装饰 ===== */
.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}
.bg-glow-pink {
  width: 520rpx;
  height: 520rpx;
  background: #FE2C55;
  top: -160rpx;
  right: -140rpx;
}
.bg-glow-cyan {
  width: 420rpx;
  height: 420rpx;
  background: #25F4EE;
  bottom: 200rpx;
  left: -180rpx;
  opacity: 0.25;
}
.bg-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1rpx, transparent 1rpx);
  background-size: 60rpx 60rpx;
  pointer-events: none;
  z-index: 0;
}

/* ===== 顶部品牌 ===== */
.brand {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding-top: calc(40rpx + env(safe-area-inset-top));
}
.brand-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FE2C55 0%, #FF6B8A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(254, 44, 85, 0.45);
}
.brand-logo-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  font-style: italic;
  line-height: 1;
}
.brand-text {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
.brand-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

/* ===== 主视觉 ===== */
.hero {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 40rpx;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: rgba(254, 44, 85, 0.14);
  border: 1rpx solid rgba(254, 44, 85, 0.35);
  margin-bottom: 36rpx;
}
.hero-tag text {
  font-size: 22rpx;
  color: #FF8AA3;
  line-height: 1;
}
.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FE2C55;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx #FE2C55;
}

.hero-title {
  font-size: 96rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
}
.hero-title-accent {
  background: linear-gradient(90deg, #FE2C55 0%, #FF8A65 50%, #25F4EE 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.hero-desc {
  margin-top: 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.62);
  max-width: 560rpx;
}

.feature-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 48rpx;
  margin-left: -12rpx;
  margin-right: -12rpx;
}
.feature-chip {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  margin: 12rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
.feature-ico {
  font-size: 28rpx;
  margin-right: 8rpx;
}
.feature-chip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ===== 底部 CTA ===== */
.bottom-panel {
  position: relative;
  z-index: 2;
  width: 100%;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding-top: 24rpx;
}
.start-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: 112rpx;
  min-width: 0 !important;
  max-width: none !important;
  border-radius: 56rpx;
  background: linear-gradient(90deg, #FE2C55 0%, #FF5577 100%);
  box-shadow: 0 12rpx 32rpx rgba(254, 44, 85, 0.45),
              0 2rpx 8rpx rgba(254, 44, 85, 0.25);
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  line-height: 112rpx;
  transition: transform 0.12s ease;
}
.start-btn::after { border: none; }
.start-btn-hover {
  transform: scale(0.97);
  box-shadow: 0 6rpx 16rpx rgba(254, 44, 85, 0.35);
}
.start-btn-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  line-height: 1;
}
.start-btn-arrow {
  font-size: 40rpx;
  font-weight: 400;
  color: #FFFFFF;
  margin-left: 16rpx;
  line-height: 1;
}

.bottom-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.tip-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}
.tip-dot {
  margin: 0 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
}
