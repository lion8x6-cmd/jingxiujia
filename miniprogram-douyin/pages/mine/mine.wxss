.page { min-height: 100vh; background: #f7f7f7; padding-bottom: 60rpx; }

/* 用户信息 */
.profile-header {
  background: linear-gradient(180deg, #FE2C55 0%, #06ad56 100%);
  padding: 48rpx 32rpx 72rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar-btn { padding: 0; margin: 0; background: transparent; line-height: 1; border: none; }
.avatar-btn::after { border: none; }
.avatar { width: 128rpx; height: 128rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); background: #fff; }
.profile-main { flex: 1; min-width: 0; }
.nickname { font-size: 38rpx; font-weight: 600; color: #fff; height: 54rpx; line-height: 54rpx; }
.nickname-placeholder { color: rgba(255,255,255,0.7); font-weight: 400; }
.user-sub { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; }

/* 会员卡片 */
.member-card {
  margin: -44rpx 32rpx 0;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}
.member-card::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(255,215,0,0.25) 0%, transparent 70%);
}
.member-card.active { background: linear-gradient(135deg, #3a3018 0%, #1a1a1a 100%); }
.member-main { flex: 1; position: relative; z-index: 1; }
.member-top { display: flex; align-items: center; gap: 16rpx; }
.member-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #1a1a1a;
  background: linear-gradient(135deg, #FFD700 0%, #FFB800 100%);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.member-action { font-size: 24rpx; color: #FFD700; }
.member-desc { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; }
.member-icon { font-size: 64rpx; position: relative; z-index: 1; }

/* 统计卡片 */
.stats-card {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.stat-divider { width: 2rpx; height: 56rpx; background: #f0f0f0; }

/* 菜单 */
.menu-section { margin: 32rpx 32rpx 0; }
.section-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; padding-left: 8rpx; }
.menu-card { background: #fff; border-radius: 20rpx; overflow: hidden; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  position: relative;
}
.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 96rpx; right: 0; bottom: 0;
  height: 2rpx;
  background: #f5f5f5;
}
.menu-icon { width: 48rpx; font-size: 36rpx; text-align: center; margin-right: 24rpx; }
.menu-title { font-size: 30rpx; color: #1a1a1a; }
.menu-desc { flex: 1; font-size: 22rpx; color: #bbb; text-align: right; margin-right: 12rpx; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.contact-btn {
  background: transparent;
  color: #FE2C55;
  border: 2rpx solid #FE2C55;
  border-radius: 32rpx;
  font-size: 22rpx;
  padding: 4rpx 24rpx;
  line-height: 1.6;
  margin: 0;
}
.contact-btn::after { border: none; }

/* 退出与版本 */
.logout-btn {
  margin: 48rpx 32rpx 0;
  background: #fff;
  color: #E24B4A;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 24rpx 0;
  border: none;
}
.logout-btn::after { border: none; }
.version { text-align: center; font-size: 22rpx; color: #ccc; margin-top: 32rpx; }

/* 会员弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.member-modal {
  position: fixed;
  left: 32rpx; right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  z-index: 201;
}
.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; }
.modal-close { font-size: 48rpx; color: #ccc; line-height: 1; }
.benefit-list { margin-bottom: 32rpx; }
.benefit-item { display: flex; gap: 20rpx; padding: 20rpx 0; }
.benefit-icon { font-size: 40rpx; width: 56rpx; text-align: center; }
.benefit-title { font-size: 28rpx; font-weight: 500; color: #1a1a1a; }
.benefit-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.member-confirm { margin-top: 8rpx; }
