.page {
  height: 100vh;
  background: #f7f7f7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #0a0a0a;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: flex 0.3s ease;
}
.stage.stage-collapsed {
  flex: 1 1 0;
  min-height: 300rpx;
}
.stage-img {
  width: 100%;
  height: 100%;
  display: block;
  transform-origin: center center;
  will-change: transform;
}
.stage-img.anim {
  transition: transform 0.2s ease-out;
}
.stage-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 左上角版本标签 */
.version-label {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  z-index: 6;
  letter-spacing: 1rpx;
}

/* 右上角操作按钮组 */
.stage-top-actions {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 6;
}

/* 右上角查看原图按钮 */
.origin-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
}
.origin-toggle:active { background: rgba(0, 0, 0, 0.75); }
.origin-toggle.active { background: #FE2C55; }
.origin-toggle .eye-icon {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  position: relative;
  display: block;
}
.origin-toggle .eye-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 9rpx;
  background: #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* 删除按钮 */
.delete-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.delete-btn:active { background: rgba(226, 75, 74, 0.9); }
.delete-ico {
  font-size: 30rpx;
  line-height: 1;
}

/* 底部版本控制栏 */
.version-bar {
  position: absolute;
  left: 0; right: 0; bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 6;
  box-sizing: border-box;
}
.ver-nav {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ver-nav:active { background: rgba(0, 0, 0, 0.75); }
.ver-nav.disabled { opacity: 0.35; }
.ver-nav-ico {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}
.prompt-btn {
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}
.prompt-btn:active { background: rgba(254, 44, 85, 0.9); }
.prompt-btn-placeholder {
  background: transparent;
  width: 72rpx;
  padding: 0;
}

/* 提示词弹窗 */
.prompt-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
}
.prompt-modal {
  position: fixed;
  left: 48rpx; right: 48rpx;
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  background: #fff;
  border-radius: 28rpx;
  z-index: 201;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s, transform 0.18s;
}
.prompt-modal.show {
  opacity: 1;
  transform: translateY(-50%) scale(1);
  pointer-events: auto;
}
.prompt-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}
.prompt-modal-body {
  max-height: 480rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.prompt-modal-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}
.prompt-modal-close {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FE2C55;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.prompt-modal-close-hover { opacity: 0.85; }

/* 左右切换箭头 */
.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.nav-arrow text {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
  margin-top: -6rpx;
}
.nav-left { left: 16rpx; }
.nav-right { right: 16rpx; }
.nav-arrow:active {
  background: rgba(0, 0, 0, 0.55);
}

.stage-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.loading-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); }
.loading-box {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
}
.loading-spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FE2C55;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #fff; }

/* 批量缩略图 */
.batch-nav {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
/* 保存弹窗打开时，缩略图提到遮罩之上，确保点击勾选不会被遮罩拦截 */
.batch-nav.above-mask {
  z-index: 102;
}
.batch-thumb {
  display: inline-block;
  position: relative;
  width: 80rpx; height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 12rpx;
  background: #eee;
  vertical-align: top;
}
.batch-thumb image { width: 100%; height: 100%; }
.batch-thumb.active { outline: 4rpx solid #FE2C55; outline-offset: 2rpx; }
.batch-thumb.fail { opacity: 0.5; }
.batch-check {
  position: absolute; bottom: 0; right: 0;
  background: #FE2C55; color: #fff;
  font-size: 18rpx;
  width: 28rpx; height: 28rpx;
  line-height: 28rpx; text-align: center;
  border-top-left-radius: 8rpx;
}
.batch-fail-dot {
  position: absolute; top: 4rpx; left: 4rpx;
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  background: #E24B4A; color: #fff;
  font-size: 20rpx;
  line-height: 28rpx; text-align: center;
}

/* 保存模式下的勾选圈 */
.batch-save-check {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0,0,0,0.4);
  color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.batch-save-check.checked {
  background: #FE2C55;
  border-color: #FE2C55;
}

/* 底部行内保存按钮（收起态和展开态共用） */
.btn-save-inline {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #FE2C55;
  background: #fff;
  gap: 2rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
}
.btn-save-inline-hover { background: #E1F5EE; }
.save-inline-ico {
  font-size: 30rpx;
  color: #FE2C55;
  line-height: 1;
  font-weight: 300;
}
.save-inline-txt {
  font-size: 22rpx;
  color: #FE2C55;
  line-height: 1;
}

/* 展开态里保存按钮高度与提交按钮对齐 */
.edit-btn-row .btn-save-inline {
  height: 88rpx;
  border-radius: 44rpx;
  margin-left: 0;
}

/* 收起态编辑按钮栏 */
.collapsed-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
}

/* 个性化修图空状态：舞台上传卡片 */
.blank-upload {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.blank-upload-card {
  width: 76%;
  max-width: 560rpx;
  border: 3rpx dashed #cfd3d8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 64rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.blank-upload-icon {
  width: 104rpx;
  height: 104rpx;
  line-height: 98rpx;
  border-radius: 50%;
  background: rgba(254, 44, 85, 0.1);
  color: #FE2C55;
  font-size: 60rpx;
  font-weight: 300;
  margin-bottom: 28rpx;
}
.blank-upload-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}
.blank-upload-sub {
  font-size: 24rpx;
  color: #9aa0a6;
  line-height: 1.6;
  margin-bottom: 36rpx;
}
.blank-upload-btn {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: #FE2C55;
  border-radius: 40rpx;
  padding: 18rpx 64rpx;
}

/* 空状态底部整宽选择图片按钮 */
.btn-blank-pick {
  flex: 1;
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: #FE2C55;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
}
.btn-blank-pick::after { border: none; }
.blank-pick-ico {
  font-size: 38rpx;
  margin-right: 12rpx;
  font-weight: 300;
}
.btn-edit-expand {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  background: #FE2C55;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0;
}
.btn-edit-expand::after { border: none; }
.edit-ico { font-size: 32rpx; color: #fff; }

/* 展开态编辑面板 */
.edit-panel {
  flex-shrink: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.28s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0.5; }
  to { transform: translateY(0); opacity: 1; }
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  flex-shrink: 0;
  border-bottom: 0.5px solid #f0f0f0;
}
.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 20rpx 0;
  color: #999;
  position: relative;
  transition: all 0.15s;
}
.mode-tab.on {
  color: #FE2C55;
  font-weight: 500;
}
.mode-tab.on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #FE2C55;
  border-radius: 2rpx;
}

/* 调节面板容器 */
.adjust-wrap {
  position: relative;
  flex-shrink: 0;
}

/* 快捷调节面板 */
.adjust-panel {
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.parts-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.part-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #ebedf0;
  background: #fff;
  color: #333;
  margin-right: 12rpx;
}
.part-chip.active {
  background: #E1F5EE;
  border-color: #FE2C55;
  color: #0F6E56;
  font-weight: 500;
}
.part-value { font-size: 22rpx; color: #FE2C55; }
.part-chip.active .part-value { color: #0F6E56; }

.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.slider-label { font-size: 26rpx; color: #333; width: 90rpx; flex-shrink: 0; }
.slider-wrap { flex: 1; }
.slider-val { font-size: 26rpx; color: #999; width: 70rpx; text-align: right; flex-shrink: 0; }
.slider-val.pos { color: #FE2C55; }
.slider-val.neg { color: #E24B4A; }

/* 一句话改图面板 */
.ai-panel {
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}

/* 一句话修图：局部修改引导条（点我去框选） */
.local-entry {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f0faf4;
  border: 2rpx solid rgba(254, 44, 85, 0.25);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}
.local-entry-hover { background: #e2f6eb; }
.local-entry-icon {
  font-size: 34rpx;
  margin-right: 14rpx;
}
.local-entry-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.local-entry-title {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  line-height: 1.3;
}
.local-entry-desc {
  font-size: 20rpx;
  color: #8a8f99;
  margin-top: 4rpx;
  line-height: 1.3;
}
.local-entry-arrow {
  font-size: 24rpx;
  color: #FE2C55;
  font-weight: 500;
  margin-left: 12rpx;
}

/* 参考图面板 */
.style-panel {
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.style-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.ref-upload {
  border: 3rpx dashed #cdd2d8;
  border-radius: 16rpx;
  background: #fafbfc;
  padding: 44rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ref-upload-hover { background: #f2f4f6; }
.ref-upload-icon {
  font-size: 56rpx;
  color: #FE2C55;
  font-weight: 300;
  line-height: 1;
}
.ref-upload-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-top: 16rpx;
}
.ref-upload-sub {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}
.ref-preview {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.ref-preview-img {
  width: 100%;
  height: 100%;
}
.ref-preview-del {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
}
.ref-preview-change {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}
.style-feature-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin: 24rpx 0 14rpx;
}
.style-feature-hint {
  font-size: 22rpx;
  color: #9aa0a6;
  font-weight: 400;
}
.style-features {
  display: flex;
  flex-wrap: wrap;
}
.style-feature {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #ebedf0;
  background: #fff;
  margin: 0 16rpx 16rpx 0;
}
.style-feature.on {
  background: #E1F5EE;
  border-color: #FE2C55;
}
.style-feature-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #cdd2d8;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 30rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
}
.style-feature-check.on {
  background: #FE2C55;
  border-color: #FE2C55;
}
.style-feature-name {
  font-size: 26rpx;
  color: #333;
}
.style-feature.on .style-feature-name {
  color: #0F6E56;
  font-weight: 500;
}

.ai-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.ai-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #333;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.5;
}
.ai-placeholder { color: #bbb; }
.ai-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.ai-quick-chip {
  font-size: 22rpx;
  color: #0F6E56;
  background: #E1F5EE;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* ===== 实时调节面板 ===== */
.filter-panel {
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.filter-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 调节项 chip 横滑栏 */
.filter-chips {
  white-space: nowrap;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 -24rpx;
  padding: 2rpx 24rpx 6rpx;
  box-sizing: content-box;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  position: relative;
  height: 56rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #f4f5f7;
  border: 2rpx solid transparent;
  vertical-align: middle;
}
.filter-chip.on {
  background: rgba(254, 44, 85, 0.1);
  border-color: #FE2C55;
}
.chip-label {
  font-size: 26rpx;
  color: #333;
  line-height: 1;
}
.filter-chip.on .chip-label {
  color: #FE2C55;
  font-weight: 600;
}
/* 已调节项绿点 */
.chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FE2C55;
  margin-right: 10rpx;
  opacity: 0;
}
.chip-dot.show {
  opacity: 1;
}

.filter-row {
  margin-top: 14rpx;
}
.filter-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter-name {
  font-size: 26rpx;
  color: #333;
}
.filter-sub {
  font-size: 20rpx;
  color: #bbb;
}
.filter-val {
  font-size: 24rpx;
  color: #999;
  min-width: 70rpx;
  text-align: right;
}
.filter-val.pos { color: #FE2C55; }
.filter-val.neg { color: #e24b4a; }
.filter-slider {
  margin: 0;
}
.filter-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 6rpx;
}
.filter-reset {
  font-size: 24rpx;
  color: #666;
  background: #f3f3f3;
  padding: 10rpx 32rpx;
  border-radius: 24rpx;
}
.filter-reset.disabled {
  color: #bbb;
}

/* 实时调节预览叠加层：盖在 stage-img 上，和 aspectFit 对齐 */
.filter-preview-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

/* 展开态底部按钮行 */
.edit-btn-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  flex-shrink: 0;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04);
}
.btn-collapse {
  flex-shrink: 0;
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #f2f2f2;
  color: #666;
  font-size: 28rpx;
}
.btn-collapse:active { background: #e8e8e8; }
.btn-submit {
  flex: 1;
  background: #FE2C55;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
  margin: 0;
}
.btn-submit::after { border: none; }
.btn-submit.disabled, .btn-submit[disabled] {
  background: #ccc;
  color: #fff;
}

/* ActionSheet */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  padding: 0 16rpx calc(16rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sheet.show { transform: translateY(0); }
.sheet-pick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
  color: #fff;
}
.sheet-pick-title { font-size: 26rpx; opacity: 0.9; }
.sheet-pick-all { font-size: 26rpx; color: #FE2C55; padding: 4rpx 8rpx; }

/* 弹窗内缩略图选择条 */
.sheet-thumbs {
  white-space: nowrap;
  padding: 0 24rpx 8rpx;
}
.sheet-thumb {
  display: inline-block;
  position: relative;
  width: 100rpx; height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
  background: #eee;
  vertical-align: top;
  opacity: 0.5;
}
.sheet-thumb image { width: 100%; height: 100%; }
.sheet-thumb.checked { opacity: 1; outline: 4rpx solid #FE2C55; outline-offset: 2rpx; }
.sheet-thumb.fail { opacity: 0.3; }
.sheet-thumb-check {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0,0,0,0.3);
  color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.sheet-thumb.checked .sheet-thumb-check {
  background: #FE2C55;
  border-color: #FE2C55;
}
.sheet-group {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.sheet-item {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0 32rpx;
  height: 104rpx;
  line-height: 104rpx;
  background: #fff;
  color: #1a1a1a;
  font-size: 32rpx;
  text-align: center;
  border: none;
  border-radius: 0;
  position: relative;
}
.sheet-item::after { border: none; }
.sheet-item-btn { font-size: 32rpx; font-weight: 400; letter-spacing: normal; }
.sheet-item-btn::after { border: none; }
.sheet-item:not(.sheet-item-last)::before {
  content: '';
  position: absolute;
  left: 32rpx; right: 32rpx; bottom: 0;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}
.sheet-item-hover { background: #f2f2f2; }
.sheet-cancel {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

/* ========== 局部编辑：选区层 ========== */
.region-layer {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 8;
}

/* 空状态指引 */
.local-guide {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -55%);
  width: 220rpx;
  height: 280rpx;
  pointer-events: none;
}
.guide-box {
  position: absolute;
  inset: 0;
  border: 4rpx dashed #FE2C55;
  border-radius: 12rpx;
  animation: guideBreath 2.2s ease-in-out infinite;
}
@keyframes guideBreath {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}
.guide-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #FE2C55;
}
.guide-corner.tl { top: -4rpx; left: -4rpx; border-right: 0; border-bottom: 0; }
.guide-corner.tr { top: -4rpx; right: -4rpx; border-left: 0; border-bottom: 0; }
.guide-corner.bl { bottom: -4rpx; left: -4rpx; border-right: 0; border-top: 0; }
.guide-corner.br { bottom: -4rpx; right: -4rpx; border-left: 0; border-top: 0; }
.guide-finger {
  position: absolute;
  left: 50%; top: 55%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
}
.guide-finger::after {
  content: '';
  position: absolute;
  left: 50%; top: 45%;
  transform: translate(-50%, -50%) rotate(-20deg);
  width: 12rpx;
  height: 32rpx;
  background: #FE2C55;
  border-radius: 6rpx;
}
.local-guide-tip {
  position: absolute;
  left: 50%; bottom: 24rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  white-space: nowrap;
  pointer-events: none;
}

/* 正在绘制的临时选区 */
.region-drawing {
  position: absolute;
  border: 3rpx solid #FE2C55;
  background: rgba(254, 44, 85, 0.1);
  z-index: 9;
}

/* 已有选区 */
.region-item {
  position: absolute;
  border: 3rpx solid rgba(254, 44, 85, 0.45);
  background: rgba(254, 44, 85, 0.06);
  box-sizing: border-box;
  z-index: 7;
}
.region-item.active {
  border-color: #FE2C55;
  background: rgba(254, 44, 85, 0.12);
  z-index: 10;
}
.region-index {
  position: absolute;
  top: -2rpx; left: -2rpx;
  min-width: 32rpx; height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #FE2C55;
  color: #fff;
  font-size: 20rpx;
  border-radius: 6rpx 0 8rpx 0;
  padding: 0 6rpx;
}
.region-delete {
  position: absolute;
  top: -16rpx; right: -16rpx;
  width: 36rpx; height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: #E24B4A;
  color: #fff;
  font-size: 28rpx;
  border-radius: 50%;
  z-index: 2;
}

/* 8 个手柄 */
.handle {
  position: absolute;
  width: 20rpx; height: 20rpx;
  background: #fff;
  border: 3rpx solid #FE2C55;
  border-radius: 50%;
  box-sizing: border-box;
}
.region-item:not(.active) .handle { display: none; }
.h-tl { top: -12rpx; left: -12rpx; }
.h-tc { top: -12rpx; left: 50%; margin-left: -10rpx; }
.h-tr { top: -12rpx; right: -12rpx; }
.h-ml { top: 50%; left: -12rpx; margin-top: -10rpx; }
.h-mr { top: 50%; right: -12rpx; margin-top: -10rpx; }
.h-bl { bottom: -12rpx; left: -12rpx; }
.h-bc { bottom: -12rpx; left: 50%; margin-left: -10rpx; }
.h-br { bottom: -12rpx; right: -12rpx; }

/* ========== 局部编辑：面板内容 ========== */
.local-panel {
  padding: 20rpx 24rpx;
}
.local-guide-card {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
}
.guide-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.guide-step:last-child { margin-bottom: 0; }
.step-num {
  flex-shrink: 0;
  width: 36rpx; height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #FE2C55;
  color: #fff;
  font-size: 22rpx;
  border-radius: 50%;
}
.step-text {
  font-size: 26rpx;
  color: #555;
  line-height: 36rpx;
}
.region-list {
  max-height: 320rpx;
}
.region-card {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}
.region-card.active {
  border-color: #FE2C55;
  background: #E1F5EE;
}
.region-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.region-card-index {
  font-size: 24rpx;
  color: #0F6E56;
  font-weight: 500;
}
.region-card-del {
  font-size: 24rpx;
  color: #E24B4A;
  padding: 4rpx 12rpx;
}
.region-card-input {
  width: 100%;
  height: 64rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}
.local-add-hint {
  text-align: center;
  font-size: 26rpx;
  color: #FE2C55;
  padding: 16rpx 0;
  border: 2rpx dashed #FE2C55;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* ============ 工具入口引导提示（改字 / 消除） ============ */
.tool-hint {
  background: #fff8ec;
  border: 2rpx solid rgba(255, 168, 46, 0.35);
  color: #b26a00;
  font-size: 23rpx;
  line-height: 1.55;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

/* ============ 老照片修复面板 ============ */
.restore-panel {
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.restore-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}
.restore-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #FE2C55;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.restore-head-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.restore-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.restore-sub {
  font-size: 23rpx;
  color: #999;
}
.restore-list {
  background: #f6fbf7;
  border: 2rpx solid rgba(254, 44, 85, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.restore-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
  padding: 7rpx 0;
}
.restore-dot {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #FE2C55;
  color: #fff;
  font-size: 20rpx;
  flex-shrink: 0;
}
.restore-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.restore-switch-hover { opacity: 0.8; }
.restore-switch-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}
.restore-switch-name {
  font-size: 27rpx;
  color: #222;
  font-weight: 500;
}
.restore-switch-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

/* 实时调节本地处理用的隐藏 canvas：移出屏幕但保持可渲染（不能 display:none，否则取不到节点） */
.filter-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 100px;
  height: 100px;
}
