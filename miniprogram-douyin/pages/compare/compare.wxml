<view class="page">
  <!-- 图片预览区：catchtouchmove 阻止放大拖动时页面滚动穿透 -->
  <view class="stage {{editExpanded ? 'stage-collapsed' : ''}}"
        bindtouchstart="onStageTouchStart"
        bindtouchend="onStageTouchEnd"
        catchtouchmove="onStageTouchMove"
        bindtouchcancel="onStageTouchCancel"
        bindlongpress="onStageLongPress">

    <!-- 个性化修图空状态：提示上传图片 -->
    <view class="blank-upload" wx:if="{{isBlank}}" bindtap="onBlankPick">
      <view class="blank-upload-card">
        <view class="blank-upload-icon">＋</view>
        <view class="blank-upload-title">上传要精修的图片</view>
        <view class="blank-upload-sub">支持从相册选择或拍照，上传后可自由编辑</view>
        <view class="blank-upload-btn">选择图片</view>
      </view>
    </view>

    <image wx:if="{{!isBlank}}" class="stage-img {{imgAnim ? 'anim' : ''}}" style="transform: translate({{imgTx}}px, {{imgTy}}px) scale({{imgScale}});" src="{{showOriginal ? currentItem.originalUrl : displayUrl}}" mode="aspectFit" bindload="onImgLoad"></image>

    <!-- 实时调节预览叠加层（Canvas 渲染的小图，所见即所得） -->
    <image wx:if="{{filterPreviewUrl && !showOriginal && editExpanded && adjustMode === 'filter'}}"
           class="filter-preview-img"
           style="transform: translate({{imgTx}}px, {{imgTy}}px) scale({{imgScale}});"
           src="{{filterPreviewUrl}}" mode="aspectFit"></image>

    <!-- 局部编辑选区层（局部修改模式显示） -->
    <view class="region-layer" wx:if="{{editExpanded && !showOriginal && !generating && adjustMode === 'local'}}">
      <!-- 空状态指引 -->
      <block wx:if="{{localRegions.length === 0 && !isDrawing}}">
        <view class="local-guide">
          <view class="guide-box"><view class="guide-corner tl"></view><view class="guide-corner tr"></view><view class="guide-corner bl"></view><view class="guide-corner br"></view></view>
          <view class="guide-finger"></view>
        </view>
        <view class="local-guide-tip">在图片上拖动手指，框选要修改的区域</view>
      </block>

      <!-- 正在绘制的临时选区 -->
      <view class="region-drawing" wx:if="{{isDrawing && drawRect}}"
            style="left:{{drawRect.x1}}px;top:{{drawRect.y1}}px;width:{{drawRect.x2 - drawRect.x1}}px;height:{{drawRect.y2 - drawRect.y1}}px"></view>

      <!-- 已有选区 -->
      <view class="region-item {{item.id === activeRegionId ? 'active' : ''}}"
            wx:for="{{localRegions}}" wx:key="id"
            style="left:{{item.sx1}}px;top:{{item.sy1}}px;width:{{item.sx2 - item.sx1}}px;height:{{item.sy2 - item.sy1}}px"
            catchtap="selectRegion" data-id="{{item.id}}">
        <text class="region-index">{{index + 1}}</text>
        <view class="region-delete" catchtap="deleteRegion" data-id="{{item.id}}">×</view>
        <view class="handle h-tl"></view><view class="handle h-tc"></view><view class="handle h-tr"></view>
        <view class="handle h-ml"></view><view class="handle h-mr"></view>
        <view class="handle h-bl"></view><view class="handle h-bc"></view><view class="handle h-br"></view>
      </view>
    </view>

    <!-- 左上角：当前版本标签 -->
    <view class="version-label" wx:if="{{!isBlank}}">{{showOriginal ? '原图（预览）' : versionLabel}}</view>

    <!-- 右上角按钮组：查看原图（点按切换/长按预览）/ 删除 -->
    <view class="stage-top-actions" wx:if="{{!generating && !isBlank}}">
      <view class="origin-toggle {{showOriginal ? 'active' : ''}}"
            catchtap="toggleOriginal"
            catchlongpress="onBtnLongPress"
            bindtouchend="releaseOriginal"
            bindtouchcancel="releaseOriginal">
        <text class="eye-icon"></text>
        <text>{{showOriginal ? '返回精修' : '查看原图'}}</text>
      </view>
      <view class="delete-btn" wx:if="{{canDeleteCurrent}}" catchtap="deleteCurrent">
        <text class="delete-ico">×</text>
      </view>
    </view>

    <!-- 左右切换批次图片箭头 -->
    <view class="nav-arrow nav-left" wx:if="{{isBatch && batchItems.length > 1 && currentIndex > 0 && !generating && !showOriginal && imgScale <= 1 && !(editExpanded && adjustMode === 'local')}}" catchtap="goPrev">
      <text>‹</text>
    </view>
    <view class="nav-arrow nav-right" wx:if="{{isBatch && batchItems.length > 1 && currentIndex < batchItems.length - 1 && !generating && !showOriginal && imgScale <= 1 && !(editExpanded && adjustMode === 'local')}}" catchtap="goNext">
      <text>›</text>
    </view>

    <!-- 底部版本控制栏 -->
    <view class="version-bar" wx:if="{{!generating && !isBlank}}">
      <view class="ver-nav {{!canGoBack ? 'disabled' : ''}}" catchtap="goVersionBack">
        <text class="ver-nav-ico">‹</text>
      </view>
      <view class="prompt-btn" wx:if="{{versionLabel !== '原图'}}" catchtap="showPrompt">
        <text>查看提示词</text>
      </view>
      <view class="prompt-btn prompt-btn-placeholder" wx:else></view>
      <view class="ver-nav {{!canGoForward ? 'disabled' : ''}}" catchtap="goVersionForward">
        <text class="ver-nav-ico">›</text>
      </view>
    </view>

    <view class="stage-loading" wx:if="{{generating}}">
      <view class="loading-mask"></view>
      <view class="loading-box">
        <view class="loading-spinner"></view>
        <text class="loading-text">生成中 {{genProgressText}}%</text>
      </view>
    </view>
  </view>

  <!-- 批量缩略图导航（保存弹窗关闭时显示在页面上） -->
  <scroll-view scroll-x class="batch-nav" wx:if="{{isBatch && batchItems.length > 1 && !showSaveSheet}}" enhanced show-scrollbar="{{false}}">
    <view class="batch-thumb {{idx === currentIndex ? 'active' : ''}} {{item.status === 'failed' ? 'fail' : ''}}"
          wx:for="{{batchItems}}" wx:key="id" wx:for-index="idx"
          bindtap="onThumbTap" data-idx="{{idx}}">
      <image src="{{item.resultUrl || item.originalUrl}}" mode="aspectFill"></image>
      <text class="batch-check" wx:if="{{idx === currentIndex}}">✓</text>
      <text class="batch-fail-dot" wx:if="{{item.status === 'failed'}}">!</text>
    </view>
  </scroll-view>

  <!-- 收起态：编辑图片 + 保存 同一行 -->
  <view class="collapsed-bar" wx:if="{{!editExpanded}}">
    <block wx:if="{{isBlank}}">
      <button class="btn-blank-pick" bindtap="onBlankPick">
        <text class="blank-pick-ico">＋</text>
        <text>选择图片开始编辑</text>
      </button>
    </block>
    <block wx:else>
      <button class="btn-edit-expand" bindtap="expandPanel">
        <text class="edit-ico">✎</text>
        <text>编辑图片</text>
      </button>
      <view class="btn-save-inline" catchtap="onSaveBtnTap" hover-class="btn-save-inline-hover" hover-stay-time="80">
        <text class="save-inline-ico">↓</text>
        <text class="save-inline-txt">保存</text>
      </view>
    </block>
  </view>

  <!-- 展开态：编辑面板 -->
  <view class="edit-panel {{editExpanded ? 'show' : ''}}" wx:if="{{editExpanded}}">
    <!-- 模式切换：老照片修复无 tab；抠图只有局部框选一个模式故无 tab；改字/消除只显示「一句话修图」「局部修改」；普通入口全量 -->
    <view class="mode-tabs" wx:if="{{adjustMode !== 'restore' && !(toolLocked && activeTool === 'cutout')}}">
      <view class="mode-tab {{adjustMode === 'ai' ? 'on' : ''}}" wx:if="{{!(toolLocked && activeTool === 'cutout')}}" bindtap="switchMode" data-mode="ai">一句话修图</view>
      <block wx:if="{{!toolLocked}}">
        <view class="mode-tab {{adjustMode === 'style' ? 'on' : ''}}" bindtap="switchMode" data-mode="style">参考图</view>
      </block>
      <view class="mode-tab {{adjustMode === 'local' ? 'on' : ''}}" bindtap="switchMode" data-mode="local">局部修改</view>
      <block wx:if="{{!toolLocked}}">
        <view class="mode-tab {{adjustMode === 'filter' ? 'on' : ''}}" bindtap="switchMode" data-mode="filter">实时调节</view>
      </block>
    </view>

    <!-- 一句话修图面板 -->
    <view class="ai-panel" hidden="{{adjustMode !== 'ai'}}">
      <!-- 局部修改引导条：点我去框选 -->
      <view class="local-entry" bindtap="gotoLocalMode" hover-class="local-entry-hover" hover-stay-time="80">
        <text class="local-entry-icon">🎯</text>
        <view class="local-entry-text">
          <text class="local-entry-title">只想改某一处？</text>
          <text class="local-entry-desc">框出手脸、天空，指哪改哪，更精准</text>
        </view>
        <text class="local-entry-arrow">去框选 ›</text>
      </view>

      <view class="ai-tip">{{aiTip}}</view>
      <textarea class="ai-input"
                placeholder="{{aiPlaceholder}}"
                placeholder-class="ai-placeholder"
                value="{{aiPrompt}}"
                bindinput="onAiPromptInput"
                maxlength="200"
                auto-height
                show-confirm-bar="{{false}}"
                adjust-position="{{true}}"/>
      <view class="ai-quick">
        <view class="ai-quick-chip" wx:for="{{aiChips}}" wx:key="text"
              bindtap="appendQuickPrompt" data-text="{{item.text}}">{{item.label}}</view>
      </view>
    </view>

    <!-- 参考图面板 -->
    <view class="style-panel" hidden="{{adjustMode !== 'style'}}">
      <view class="style-tip">上传一张喜欢的参考图，勾选要借鉴的风格，自动把它套到你的照片上（人物不变）</view>

      <!-- 参考图上传区 -->
      <view class="ref-upload" wx:if="{{!refImagePath}}" bindtap="onPickRefImage" hover-class="ref-upload-hover" hover-stay-time="80">
        <text class="ref-upload-icon">＋</text>
        <text class="ref-upload-text">上传风格参考图</text>
        <text class="ref-upload-sub">从相册选一张你喜欢色调/氛围的图</text>
      </view>
      <view class="ref-preview" wx:else>
        <image class="ref-preview-img" src="{{refImagePath}}" mode="aspectFill"></image>
        <view class="ref-preview-del" catchtap="onRemoveRefImage">×</view>
        <view class="ref-preview-change" catchtap="onPickRefImage">换一张</view>
      </view>

      <!-- 特征勾选 -->
      <view class="style-feature-label">借鉴哪些风格？<text class="style-feature-hint">（可多选）</text></view>
      <view class="style-features">
        <view class="style-feature {{item.on ? 'on' : ''}}"
              wx:for="{{styleFeatureChips}}" wx:key="key"
              bindtap="onToggleStyleFeature" data-key="{{item.key}}">
          <view class="style-feature-check {{item.on ? 'on' : ''}}">{{item.on ? '✓' : ''}}</view>
          <text class="style-feature-name">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 老照片修复面板（仅工具入口进入，无 tab） -->
    <view class="restore-panel" hidden="{{adjustMode !== 'restore'}}">
      <view class="restore-head">
        <text class="restore-icon">修</text>
        <view class="restore-head-text">
          <text class="restore-title">老照片一键修复</text>
          <text class="restore-sub">自动完成，无需任何操作</text>
        </view>
      </view>
      <view class="restore-list">
        <view class="restore-item"><text class="restore-dot">✓</text><text>修复划痕、折痕、霉点、破损</text></view>
        <view class="restore-item"><text class="restore-dot">✓</text><text>模糊人脸与细节增强、提升清晰度</text></view>
        <view class="restore-item"><text class="restore-dot">✓</text><text>校正褪色发黄，恢复自然色彩</text></view>
        <view class="restore-item"><text class="restore-dot">✓</text><text>降噪去颗粒，人物长相姿势完全不变</text></view>
      </view>
      <view class="restore-switch-row">
        <view class="restore-switch-text" bindtap="onToggleRestoreColorize" hover-class="restore-switch-hover" hover-stay-time="60">
          <text class="restore-switch-name">黑白照片自动上色</text>
          <text class="restore-switch-desc">关闭则只修复不上色（彩色老照片不受影响）</text>
        </view>
        <switch checked="{{restoreColorize}}" disabled="{{generating}}" color="#FE2C55" bindchange="onRestoreColorizeChange"/>
      </view>
    </view>

    <!-- 局部修改面板 -->
    <view class="local-panel" hidden="{{adjustMode !== 'local'}}">
      <!-- 工具入口引导：改字 / 消除 / 抠图 -->
      <view class="tool-hint" wx:if="{{toolHint}}">💡 {{toolHint}}</view>
      <!-- 空状态指引 -->
      <view class="local-guide-card" wx:if="{{localRegions.length === 0}}">
        <view class="guide-step"><text class="step-num">1</text><text class="step-text">在图片上拖动手指，框选要{{toolLocked && activeTool === 'cutout' ? '抠出' : '修改'}}的区域</text></view>
        <view class="guide-step"><text class="step-num">2</text><text class="step-text">{{localExample}}</text></view>
        <view class="guide-step" wx:if="{{!(toolLocked && activeTool === 'cutout')}}"><text class="step-num">3</text><text class="step-text">可继续添加多个区域，或直接提交生成</text></view>
        <view class="guide-step" wx:if="{{toolLocked && activeTool === 'cutout'}}"><text class="step-num">3</text><text class="step-text">框好后点下方「一键抠出透明图」即可</text></view>
      </view>

      <!-- 已有区域列表（抠图模式不显示指令输入框，框选即抠） -->
      <scroll-view scroll-y class="region-list" wx:if="{{localRegions.length > 0}}">
        <view class="region-card {{item.id === activeRegionId ? 'active' : ''}}"
              wx:for="{{localRegions}}" wx:key="id"
              bindtap="selectRegion" data-id="{{item.id}}">
          <view class="region-card-head">
            <text class="region-card-index">区域 {{index + 1}}{{toolLocked && activeTool === 'cutout' ? '（待抠出）' : ''}}</text>
            <text class="region-card-del" catchtap="deleteRegion" data-id="{{item.id}}">删除</text>
          </view>
          <input wx:if="{{!(toolLocked && activeTool === 'cutout')}}" class="region-card-input" placeholder="{{regionPlaceholder}}"
                 value="{{item.prompt}}" data-id="{{item.id}}"
                 bindinput="onRegionPromptInput" maxlength="100"/>
        </view>
      </scroll-view>

      <view class="local-add-hint" wx:if="{{localRegions.length > 0 && localRegions.length < 5 && !(toolLocked && activeTool === 'cutout')}}"
            bindtap="addNewRegion">+ 继续框选新区域</view>
    </view>

    <!-- 实时调节面板（本地处理，拖动即预览，不耗 AI） -->
    <view class="filter-panel" hidden="{{adjustMode !== 'filter'}}">
      <view class="filter-tip">拖动滑块即时预览，效果本地处理、不消耗次数</view>

      <!-- 调节项 chip 横滑栏（绿点表示该项已调节） -->
      <scroll-view scroll-x class="filter-chips" enhanced show-scrollbar="{{false}}">
        <view class="filter-chip {{item.on ? 'on' : ''}}"
              wx:for="{{filterChips}}" wx:key="key"
              bindtap="onSelectFilter" data-key="{{item.key}}">
          <view class="chip-dot {{item.adjusted ? 'show' : ''}}"></view>
          <text class="chip-label">{{item.label}}</text>
        </view>
      </scroll-view>

      <!-- 当前选中项的单个滑块 -->
      <view class="filter-row">
        <view class="filter-row-head">
          <text class="filter-name">{{activeFilterLabel}}<text class="filter-sub" wx:if="{{activeFilterSub}}"> {{activeFilterSub}}</text></text>
          <text class="filter-val {{activeFilterVal > 0 ? 'pos' : activeFilterVal < 0 ? 'neg' : ''}}">{{activeFilterVal > 0 ? '+' : ''}}{{activeFilterVal}}</text>
        </view>
        <slider class="filter-slider" min="{{activeFilterMin}}" max="{{activeFilterMax}}" value="{{activeFilterVal}}"
                activeColor="#FE2C55" backgroundColor="#e5e5e5" block-size="22"
                bindchanging="onFilterChanging" bindchange="onFilterChange"/>
      </view>

      <view class="filter-actions">
        <view class="filter-reset {{hasFilter ? '' : 'disabled'}}" bindtap="resetFilter">重置全部</view>
      </view>
    </view>

    <!-- 底部按钮：老照片修复模式只留「一键修复」，隐藏收起/保存；其他模式 收起+提交+保存 -->
    <view class="edit-btn-row">
      <view class="btn-collapse" wx:if="{{adjustMode !== 'restore'}}" bindtap="collapsePanel">收起</view>
      <button class="btn-submit {{!canSubmit || generating ? 'disabled' : ''}}" bindtap="submitAdjust" disabled="{{!canSubmit || generating}}">
        <text wx:if="{{adjustMode === 'restore' && !generating}}">一键修复</text>
        <text wx:elif="{{adjustMode === 'filter' && !generating}}">应用调节</text>
        <text wx:elif="{{submitText && !generating}}">{{submitText}}</text>
        <text wx:elif="{{!generating}}">提交修改并生成</text>
        <text wx:else>处理中 {{genProgressText}}%</text>
      </button>
      <view class="btn-save-inline" wx:if="{{adjustMode !== 'restore'}}" catchtap="onSaveBtnTap" hover-class="btn-save-inline-hover" hover-stay-time="80">
        <text class="save-inline-ico">↓</text>
        <text class="save-inline-txt">保存</text>
      </view>
    </view>
  </view>

  <!-- 保存底部弹窗 ActionSheet -->
  <view class="sheet-mask" wx:if="{{showSaveSheet}}" bindtap="closeSaveSheet"></view>
  <view class="sheet {{showSaveSheet ? 'show' : ''}}">
    <block wx:if="{{isBatch && batchItems.length > 1}}">
      <view class="sheet-pick-head">
        <text class="sheet-pick-title">选择要保存的图片（已选 {{selectedSaveIds.length}} 张）</text>
        <view class="sheet-pick-all" bindtap="toggleSelectAllSave">{{isAllSaveSelected ? '取消全选' : '全选'}}</view>
      </view>
      <scroll-view scroll-x class="sheet-thumbs" enhanced show-scrollbar="{{false}}">
        <view class="sheet-thumb {{selectedSaveMap[item.id] ? 'checked' : ''}} {{item.status === 'failed' ? 'fail' : ''}}"
              wx:for="{{batchItems}}" wx:key="id" wx:for-index="idx"
              bindtap="onThumbTap" data-idx="{{idx}}">
          <image src="{{item.resultUrl || item.originalUrl}}" mode="aspectFill"></image>
          <view class="sheet-thumb-check">
            <text wx:if="{{selectedSaveMap[item.id]}}">✓</text>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-group">
        <view class="sheet-item" bindtap="batchSaveToLocal" hover-class="sheet-item-hover" hover-stay-time="80">保存至本地相册</view>
        <view class="sheet-item" bindtap="batchSaveToCloud" hover-class="sheet-item-hover" hover-stay-time="80">保存到云相册</view>
        <button class="sheet-item sheet-item-btn sheet-item-last" open-type="share" bindtap="closeSaveSheet" hover-class="sheet-item-hover">分享给好友</button>
      </view>
    </block>
    <block wx:else>
      <view class="sheet-group">
        <view class="sheet-item" bindtap="saveToLocal" hover-class="sheet-item-hover" hover-stay-time="80">保存图片至本地</view>
        <button class="sheet-item sheet-item-btn" open-type="share" bindtap="closeSaveSheet" hover-class="sheet-item-hover">分享给好友</button>
        <view class="sheet-item sheet-item-last" bindtap="saveToAlbum" hover-class="sheet-item-hover" hover-stay-time="80">保存到云相册</view>
      </view>
    </block>
    <view class="sheet-cancel" bindtap="closeSaveSheet" hover-class="sheet-item-hover" hover-stay-time="80">取消</view>
  </view>

  <!-- 提示词弹窗 -->
  <view class="prompt-mask" wx:if="{{showPromptModal}}" bindtap="closePrompt"></view>
  <view class="prompt-modal {{showPromptModal ? 'show' : ''}}" catchtap="">
    <view class="prompt-modal-title">本版提示词</view>
    <scroll-view scroll-y class="prompt-modal-body">
      <text class="prompt-modal-text">{{promptContent}}</text>
    </scroll-view>
    <view class="prompt-modal-close" bindtap="closePrompt" hover-class="prompt-modal-close-hover">知道了</view>
  </view>

  <!-- 实时调节本地处理用的页面 canvas（常驻隐藏；抖音离屏 canvas 无 createImage，必须用页面节点） -->
  <canvas type="2d" id="filterCanvas" class="filter-canvas"></canvas>
</view>
