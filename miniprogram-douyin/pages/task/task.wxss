page { background: #f5f6f8; }
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
}

/* 示意横幅 */
.mock-banner {
  display: flex;
  align-items: center;
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}
.mock-banner-tag {
  flex-shrink: 0;
  background: #FA8C16;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}
.mock-banner-text {
  font-size: 22rpx;
  color: #ad6800;
  line-height: 1.5;
}

/* 任务卡片 */
.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.task-head {
  display: flex;
  align-items: center;
}
.brand-logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: block;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(254, 44, 85, 0.25);
}
.brand-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}
.brand-tags {
  display: flex;
  margin-top: 10rpx;
}
.brand-tag {
  font-size: 20rpx;
  color: #FE2C55;
  background: rgba(254, 44, 85, 0.08);
  border: 1rpx solid rgba(254, 44, 85, 0.3);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}
.brand-tag.hot {
  color: #fff;
  background: #FE2C55;
  border-color: #FE2C55;
}

.reward-row {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff1f3 0%, #fff7f8 100%);
  border-radius: 16rpx;
  padding: 26rpx 0;
  margin-top: 24rpx;
}
.reward-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.reward-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #FE2C55;
}
.reward-label {
  font-size: 21rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}
.reward-divider {
  width: 2rpx;
  height: 56rpx;
  background: #f0d7db;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 14rpx;
}
.block-text {
  font-size: 25rpx;
  color: #555;
  line-height: 1.7;
}
.task-desc { margin-top: 28rpx; }

.task-req { margin-top: 26rpx; }
.req-item {
  display: flex;
  align-items: flex-start;
  font-size: 25rpx;
  color: #555;
  line-height: 1.7;
}
.req-dot {
  color: #FE2C55;
  margin-right: 12rpx;
  font-weight: 700;
}

/* 素材 */
.material-box {
  margin-top: 26rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 22rpx;
}
.material-row {
  display: flex;
  align-items: center;
}
.material-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.material-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6b9bf;
  font-size: 22rpx;
}
.material-text {
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}
.material-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #222;
}
.material-sub {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}
.copy-line {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.copy-line-label {
  color: #666;
  font-weight: 600;
}
.copy-line-text {
  color: #444;
}
.copy-line-tip { color: #b6b9bf; }

/* 步骤 */
.steps { margin-top: 28rpx; }
.step-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 22rpx;
}
.step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FE2C55;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  margin-top: 4rpx;
}
.step-content {
  display: flex;
  flex-direction: column;
}
.step-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #222;
}
.step-desc {
  font-size: 23rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 收益卡 */
.income-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}

.bottom-space { height: 180rpx; }

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.btn-post {
  width: 100%;
  background: linear-gradient(90deg, #FE2C55 0%, #FF5577 100%);
  color: #fff;
  font-size: 31rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 22rpx 0;
  border: none;
  line-height: 1.4;
}
.btn-post::after { border: none; }
.footer-note {
  font-size: 20rpx;
  color: #b6b9bf;
  margin-top: 10rpx;
}
