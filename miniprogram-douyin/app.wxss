/* 全局样式 - 抖音配色 */
page {
  --primary: #FE2C55;
  --primary-dark: #E01E44;
  --primary-light: #FFE8EE;
  --warning: #EF9F27;
  --warning-light: #FAEEDA;
  --danger: #E24B4A;
  --danger-light: #FCEBEB;
  --text-primary: #161823;
  --text-secondary: #545968;
  --text-hint: #9BA0AE;
  --bg-page: #F7F8FA;
  --bg-card: #ffffff;
  --border-color: #ebedf0;
  background-color: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  width: 100%;
  overflow-x: hidden;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
}

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 16rpx;
  padding: 22rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.btn-ghost {
  background: #f5f5f5;
  color: var(--text-secondary);
  border: none;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-success {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.tag-warning {
  background: var(--warning-light);
  color: #854F0B;
}

.tag-danger {
  background: var(--danger-light);
  color: #A32D2D;
}

.flex {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.text-hint {
  color: var(--text-hint);
  font-size: 24rpx;
}

.text-danger {
  color: var(--danger);
}

.text-primary {
  color: var(--primary);
}

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
