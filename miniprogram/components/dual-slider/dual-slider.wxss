.dual-slider {
  padding: 20rpx 0 10rpx;
  width: 100%;
}

.slider-track {
  position: relative;
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
}

.track-negative,
.track-positive {
  position: absolute;
  top: 0;
  height: 100%;
  border-radius: 4rpx;
}

.track-negative {
  right: 50%;
}

.track-positive {
  left: 50%;
}

.track-zero {
  position: absolute;
  top: -6rpx;
  width: 4rpx;
  height: 20rpx;
  background: #555;
  transform: translateX(-2rpx);
  border-radius: 2rpx;
}

.slider-thumb {
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border: 4rpx solid #07C160;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.thumb-negative {
  border-color: #E24B4A;
}

.slider-labels {
  position: relative;
  margin-top: 16rpx;
  height: 30rpx;
}

.slider-labels text {
  font-size: 22rpx;
  color: #999;
  position: absolute;
}

.label-negative {
  left: 0;
  color: #E24B4A !important;
}

.label-zero {
  left: 50%;
  transform: translateX(-50%);
}

.label-positive {
  right: 0;
  color: #07C160 !important;
}

.slider-value {
  text-align: right;
  margin-top: 8rpx;
}

.slider-value text {
  font-size: 28rpx;
  font-weight: 500;
}

.text-neg { color: #E24B4A; }
.text-pos { color: #07C160; }
