.page { min-height: 100vh; background: #f7f7f7; display: flex; flex-direction: column; }
.preview-area { position: relative; background: #1a1a1a; height: 55vh; display: flex; align-items: center; justify-content: center; }
.preview-img { max-width: 100%; max-height: 100%; }
.preview-badge { position: absolute; top: 24rpx; right: 24rpx; background: rgba(7,193,96,0.9); color: #fff; font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 24rpx; }
.control-panel { flex: 1; background: #fff; border-radius: 32rpx 32rpx 0 0; margin-top: -24rpx; padding: 32rpx; position: relative; z-index: 2; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.parts-scroll { white-space: nowrap; margin-bottom: 32rpx; }
.part-chip { display: inline-flex; flex-direction: column; align-items: center; padding: 16rpx 28rpx; margin-right: 20rpx; background: #f7f7f7; border-radius: 20rpx; min-width: 120rpx; position: relative; }
.part-chip.active { background: #E1F5EE; border: 2rpx solid #07C160; }
.part-icon { font-size: 36rpx; margin-bottom: 8rpx; }
.part-name { font-size: 24rpx; color: #333; }
.part-value { position: absolute; top: -8rpx; right: -8rpx; background: #07C160; color: #fff; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 16rpx; }
.slider-section { margin-bottom: 32rpx; }
.slider-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.slider-label { font-size: 28rpx; font-weight: 500; color: #1a1a1a; }
.slider-value { font-size: 32rpx; font-weight: 600; color: #07C160; }
.slider-value.neg { color: #E24B4A; }
.slider-hint { font-size: 22rpx; color: #bbb; text-align: center; margin-top: 8rpx; }
.active-adjustments { margin-bottom: 24rpx; }
.adj-title { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.adj-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.adj-tag { display: inline-flex; align-items: center; gap: 8rpx; background: #E1F5EE; color: #0F6E56; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 24rpx; }
.adj-remove { font-size: 28rpx; color: #0F6E56; opacity: 0.6; }
.action-row { display: flex; gap: 20rpx; margin-top: 16rpx; }
.btn-reset { flex: 1; background: #f5f5f5; color: #666; border-radius: 48rpx; font-size: 28rpx; border: none; }
.btn-reset::after { border: none; }
.btn-submit { flex: 2; background: #07C160; color: #fff; border-radius: 48rpx; font-size: 28rpx; font-weight: 500; border: none; }
.btn-submit::after { border: none; }
.btn-submit[disabled], .btn-reset[disabled] { opacity: 0.5; }
