.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 40rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.progress-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 48rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.progress-info {
  text-align: center;
  margin-top: 32rpx;
}

.progress-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.progress-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 3 列网格，最多 9 张 */
.batch-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 32rpx;
  box-sizing: border-box;
}

.grid-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eaeaea;
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 右上角已完成：绿色圆勾，带白色描边，不压蒙版 */
.corner-done {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 右上角失败：红色感叹号 */
.corner-fail {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E24B4A;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 右上角已取消：灰色暂停 */
.corner-cancel {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #999;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 右下角处理中：半透明黑底白菊花 */
.corner-spin {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 右下角等待中：小白点 */
.corner-pending {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 停止生成按钮 */
.action-row {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.btn-stop {
  background: #fff;
  color: #E24B4A;
  border: 2rpx solid #E24B4A;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 80rpx;
  line-height: 1.4;
}
.btn-stop::after { border: none; }
.btn-stop:active { background: #fef0f0; }

.btn-stopped {
  background: #f5f5f5;
  color: #bbb;
  border: 2rpx solid #e0e0e0;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 80rpx;
  line-height: 1.4;
}
.btn-stopped::after { border: none; }

.tips-card {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.tip-item {
  display: flex;
  align-items: center;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
}

.btn-background {
  margin-top: 24rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.btn-background::after {
  border: none;
}
