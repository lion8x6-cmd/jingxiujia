.page {
  height: 100vh;
  background: #f7f7f7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #0a0a0a;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stage-img {
  width: 100%;
  height: 100%;
  display: block;
  transform-origin: center center;
  will-change: transform;
}
.stage-img.anim {
  transition: transform 0.2s ease-out;
}
.stage-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 左上角版本标签 */
.version-label {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  z-index: 6;
  letter-spacing: 1rpx;
}

/* 右上角操作按钮组 */
.stage-top-actions {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 6;
}

/* 右上角查看原图按钮 */
.origin-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
}
.origin-toggle:active { background: rgba(0, 0, 0, 0.75); }
.origin-toggle.active { background: #07C160; }
.origin-toggle .eye-icon {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  position: relative;
  display: block;
}
.origin-toggle .eye-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 9rpx;
  background: #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* 删除按钮 */
.delete-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.delete-btn:active { background: rgba(226, 75, 74, 0.9); }
.delete-ico {
  font-size: 30rpx;
  line-height: 1;
}

/* 底部版本控制栏 */
.version-bar {
  position: absolute;
  left: 0; right: 0; bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  z-index: 6;
  box-sizing: border-box;
}
.ver-nav {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ver-nav:active { background: rgba(0, 0, 0, 0.75); }
.ver-nav.disabled { opacity: 0.35; }
.ver-nav-ico {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}
.prompt-btn {
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}
.prompt-btn:active { background: rgba(7, 193, 96, 0.9); }
.prompt-btn-placeholder {
  background: transparent;
  width: 72rpx;
  padding: 0;
}

/* 提示词弹窗 */
.prompt-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
}
.prompt-modal {
  position: fixed;
  left: 48rpx; right: 48rpx;
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  background: #fff;
  border-radius: 28rpx;
  z-index: 201;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s, transform 0.18s;
}
.prompt-modal.show {
  opacity: 1;
  transform: translateY(-50%) scale(1);
  pointer-events: auto;
}
.prompt-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}
.prompt-modal-body {
  max-height: 480rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.prompt-modal-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}
.prompt-modal-close {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #07C160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.prompt-modal-close-hover { opacity: 0.85; }

/* 左右切换箭头 */
.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.nav-arrow text {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
  margin-top: -6rpx;
}
.nav-left { left: 16rpx; }
.nav-right { right: 16rpx; }
.nav-arrow:active {
  background: rgba(0, 0, 0, 0.55);
}

.stage-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.loading-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); }
.loading-box {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
}
.loading-spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #fff; }

/* 批量缩略图 */
.batch-nav {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
/* 保存弹窗打开时，缩略图提到遮罩之上，确保点击勾选不会被遮罩拦截 */
.batch-nav.above-mask {
  z-index: 102;
}
.batch-thumb {
  display: inline-block;
  position: relative;
  width: 80rpx; height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 12rpx;
  background: #eee;
  vertical-align: top;
}
.batch-thumb image { width: 100%; height: 100%; }
.batch-thumb.active { outline: 4rpx solid #07C160; outline-offset: 2rpx; }
.batch-thumb.fail { opacity: 0.5; }
.batch-check {
  position: absolute; bottom: 0; right: 0;
  background: #07C160; color: #fff;
  font-size: 18rpx;
  width: 28rpx; height: 28rpx;
  line-height: 28rpx; text-align: center;
  border-top-left-radius: 8rpx;
}
.batch-fail-dot {
  position: absolute; top: 4rpx; left: 4rpx;
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  background: #E24B4A; color: #fff;
  font-size: 20rpx;
  line-height: 28rpx; text-align: center;
}

/* 保存模式下的勾选圈 */
.batch-save-check {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0,0,0,0.4);
  color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.batch-save-check.checked {
  background: #07C160;
  border-color: #07C160;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx 0;
  gap: 16rpx;
  flex-shrink: 0;
}
.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.15s;
}
.mode-tab.on {
  color: #07C160;
  font-weight: 600;
  border-bottom-color: #07C160;
}

/* 调节面板容器：固定高度 + 绝对定位子面板，切换时舞台高度完全不变，彻底杜绝闪烁 */
.adjust-wrap {
  position: relative;
  flex-shrink: 0;
  height: 360rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  overflow: hidden;
}

/* 快捷调节面板 */
.adjust-panel {
  position: absolute;
  left: 0; right: 0; top: 0;
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.parts-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.part-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #ebedf0;
  background: #fff;
  color: #333;
  margin-right: 12rpx;
}
.part-chip.active {
  background: #E1F5EE;
  border-color: #07C160;
  color: #0F6E56;
  font-weight: 500;
}
.part-value { font-size: 22rpx; color: #07C160; }
.part-chip.active .part-value { color: #0F6E56; }

.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.slider-label { font-size: 26rpx; color: #333; width: 90rpx; flex-shrink: 0; }
.slider-wrap { flex: 1; }
.slider-val { font-size: 26rpx; color: #999; width: 70rpx; text-align: right; flex-shrink: 0; }
.slider-val.pos { color: #07C160; }
.slider-val.neg { color: #E24B4A; }

/* AI 调节面板 */
.ai-panel {
  position: absolute;
  left: 0; right: 0; top: 0;
  background: #fff;
  padding: 20rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.ai-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.ai-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #333;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.5;
}
.ai-placeholder { color: #bbb; }
.ai-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.ai-quick-chip {
  font-size: 22rpx;
  color: #0F6E56;
  background: #E1F5EE;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 按钮行 */
.btn-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  margin-top: auto;
  flex-shrink: 0;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.04);
}
.btn-submit {
  flex: 1;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 22rpx 0;
  border-radius: 48rpx;
  border: none;
  line-height: 1.4;
  margin: 0;
}
.btn-submit::after { border: none; }
.btn-submit[disabled] { background: #ccc; color: #fff; }

/* 保存按钮：紧凑胶囊图标+文字 */
.btn-save {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #fff;
  border: 3rpx solid #07C160;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: background 0.15s;
}
.btn-save-hover {
  background: #E1F5EE;
}
.save-ico {
  font-size: 32rpx;
  color: #07C160;
  line-height: 1;
  font-weight: 300;
}
.save-txt {
  font-size: 26rpx;
  color: #07C160;
  line-height: 1;
}

/* ActionSheet */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  padding: 0 16rpx calc(16rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sheet.show { transform: translateY(0); }
.sheet-pick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  color: #fff;
}
.sheet-pick-title { font-size: 26rpx; opacity: 0.9; }
.sheet-pick-all { font-size: 26rpx; color: #07C160; padding: 4rpx 8rpx; }
.sheet-group {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.sheet-item {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0 32rpx;
  height: 104rpx;
  line-height: 104rpx;
  background: #fff;
  color: #1a1a1a;
  font-size: 32rpx;
  text-align: center;
  border: none;
  border-radius: 0;
  position: relative;
}
.sheet-item::after { border: none; }
.sheet-item-btn { font-size: 32rpx; font-weight: 400; letter-spacing: normal; }
.sheet-item-btn::after { border: none; }
.sheet-item:not(.sheet-item-last)::before {
  content: '';
  position: absolute;
  left: 32rpx; right: 32rpx; bottom: 0;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}
.sheet-item-hover { background: #f2f2f2; }
.sheet-cancel {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}
