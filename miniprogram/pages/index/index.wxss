page {
  height: 100%;
}

.page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bottom-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 56rpx 12rpx 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.start-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: 108rpx;
  min-width: 0 !important;
  max-width: none !important;
  border-radius: 54rpx;
  background: linear-gradient(180deg, #0DD66F 0%, #07C160 50%, #06A852 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  line-height: 108rpx;
  transition: transform 0.12s ease;
}
.start-btn::after { border: none; }

.start-btn-hover {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.start-btn-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  line-height: 1;
}

.start-btn-arrow {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-left: 20rpx;
  line-height: 1;
}
