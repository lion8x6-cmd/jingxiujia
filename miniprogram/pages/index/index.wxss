page {
  height: 100%;
}

.page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bottom-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 44rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  box-sizing: border-box;
}

.start-btn {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: 104rpx;
  min-width: 0 !important;
  max-width: none !important;
  border-radius: 50rpx;
  background: linear-gradient(180deg, #0DD66F 0%, #07C160 50%, #06A852 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  border: none;
  padding: 16rpx 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease;
}
.start-btn::after { border: none; }

.start-btn-hover {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.start-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-btn-text {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  line-height: 1;
}

.start-btn-arrow {
  font-size: 38rpx;
  font-weight: 400;
  color: #FFFFFF;
  margin-left: 16rpx;
  line-height: 1;
}

.start-btn-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  line-height: 1;
}

/* 个性化修图入口 */
.custom-entry {
  margin-top: 24rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #07C160;
  background: rgba(7, 193, 96, 0.06);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: transform 0.12s ease;
}
.custom-entry-hover {
  transform: scale(0.97);
  background: rgba(7, 193, 96, 0.12);
}
.custom-entry-icon {
  font-size: 34rpx;
  color: #07C160;
  margin-right: 12rpx;
  line-height: 1;
}
.custom-entry-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #07C160;
  letter-spacing: 2rpx;
  line-height: 1;
}
.custom-entry-sub {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa0a6;
  line-height: 1;
}

/* 更多工具宫格 */
.tools-head {
  display: flex;
  align-items: baseline;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}
.tools-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}
.tools-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}
.tools-grid {
  display: flex;
  flex-wrap: wrap;
}
.tool-item {
  width: 48%;
  box-sizing: border-box;
  height: 108rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 20rpx;
  padding: 0 20rpx;
  margin-right: 4%;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.tool-item:nth-child(even) { margin-right: 0; }
.tool-item.hl {
  border-color: #07C160;
  background: #f6fbf7;
}
.tool-item-hover { background: #f4f5f7; }
.tool-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.tool-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.tool-icon-blue   { background: #E6F1FB; }
.tool-icon-purple { background: #EEEDFE; }
.tool-icon-green  { background: #E1F5EE; }
.tool-icon-amber  { background: #FAEEDA; }
.tool-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.tool-name {
  font-size: 25rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tool-sub {
  font-size: 20rpx;
  color: #9aa0a6;
  line-height: 1.25;
  margin-top: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 赚钱悬浮按钮（分销素材入口） */
.money-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FF8A3D 0%, #FF6B1A 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 26, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
  transition: transform 0.12s ease;
}
.money-fab-hover { transform: scale(0.92); }
.money-fab-yen {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}
.money-fab-txt {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  margin-top: 4rpx;
}
