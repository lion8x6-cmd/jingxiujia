<view class="page">
  <view class="canvas-area">
    <image class="edit-image" src="{{imageSrc}}" mode="aspectFit" id="eraseImage" bindload="onImageReady"></image>
    <canvas type="2d" id="eraseCanvas" class="erase-canvas"
            disable-scroll="{{true}}"
            bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    </canvas>
    <view class="canvas-hint" wx:if="{{!hasStroke}}">涂抹要消除的物体</view>
  </view>

  <view class="tool-bar">
    <view class="tool-tabs">
      <view class="tool-tab {{brushMode === 'erase' ? 'active' : ''}}" bindtap="setMode" data-mode="erase">
        <text>画笔</text>
      </view>
      <view class="tool-tab {{brushMode === 'rubber' ? 'active' : ''}}" bindtap="setMode" data-mode="rubber">
        <text>橡皮擦</text>
      </view>
    </view>
    <view class="brush-size">
      <text class="size-label">画笔大小</text>
      <slider min="5" max="50" value="{{brushSize}}" block-color="#07C160"
              activeColor="#07C160" bindchange="onSizeChange" class="size-slider"/>
    </view>
  </view>

  <view class="edit-panel">
    <view class="panel-actions">
      <button class="btn-cancel" bindtap="clearStroke">清除涂抹</button>
      <button class="btn-submit" bindtap="submitErase" disabled="{{!hasStroke}}">消除</button>
    </view>
  </view>
</view>
